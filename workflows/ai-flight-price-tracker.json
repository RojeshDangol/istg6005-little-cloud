    {
      "parameters": {
        "jsCode": "const records = $input.all()\n  .map(item => item.json)\n  .filter(r => r.cheapest_price != null &&\n    Number(r.cheapest_price) > 0)\n  .sort((a, b) =>\n    new Date(a.createdAt) - new Date(b.createdAt));\n\nif (records.length === 0) {\n  return [{ json: { message: \"No valid price data\" } }];\n}\n\nconst prices = records.map(r => Number(r.cheapest_price));\nconst latest = records[records.length - 1];\nconst current = prices[prices.length - 1];\nconst previous = prices.length > 1\n  ? prices[prices.length - 2] : null;\n\nconst average = prices.reduce((a, b) => a + b, 0)\n  / prices.length;\n\nconst change = previous !== null\n  ? current - previous : null;\n\nconst percentChange = previous !== null\n  ? (change / previous) * 100 : null;\n\nlet trend = \"INSUFFICIENT DATA\";\nlet recommendation = \"COLLECT MORE DATA\";\n\nif (prices.length >= 2) {\n  trend = change < 0 ? \"FALLING\"\n    : change > 0 ? \"RISING\" : \"STABLE\";\n\n  recommendation = current > latest.budget\n    ? \"OVER BUDGET - MONITOR\"\n    : current <= average\n      ? \"CONSIDER BUYING\"\n      : \"MONITOR PRICE\";\n}\n\nreturn [{\n  json: {\n    origin: latest.origin,\n    destination: latest.destination,\n    outbound_date: latest.outbound_date,\n    return_date: latest.return_date,\n    historical_records: prices.length,\n    current_price: current,\n    previous_price: previous,\n    average_price: Number(average.toFixed(2)),\n    lowest_price: Math.min(...prices),\n    highest_price: Math.max(...prices),\n    price_change: change,\n    percentage_change: percentChange !== null\n      ? Number(percentChange.toFixed(2)) : null,\n    budget: latest.budget,\n    trend: trend,\n    recommendation: recommendation,\n    ai_analysis: latest.ai_analysis\n  }\n}];"
      },
