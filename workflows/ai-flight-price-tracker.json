    {
      "parameters": {
        "jsCode": "\nconst data = $('HTTP Request').first().json;\nconst request = $('Edit Fields').first().json;\nconst budget = Number(request.budget);\n\nconst raw = $input.first().json;\nlet ai = raw.output ?? raw.text ?? raw;\n\nif (typeof ai === 'string') {\n  try {\n    ai = JSON.parse(ai);\n  } catch {\n    ai = null;\n  }\n}\n\nconst flights = [\n  ...(data.best_flights || []),\n  ...(data.other_flights || [])\n].filter(f => typeof f.price === 'number' && f.price > 0);\n\nconst prices = flights.map(f => f.price);\nconst cheapest = prices.length\n  ? Math.min(...prices) : null;\n\nconst errors = [];\n\nif (cheapest === null) {\n  errors.push(\"No flights found\");\n}\n\nif (!ai || ai.status !== \"success\") {\n  errors.push(\"Invalid AI output\");\n}\n\nif (ai?.cheapest_price !== cheapest) {\n  errors.push(\"AI cheapest price does not match flight data\");\n}\n\nif (!prices.includes(ai?.recommended_price)) {\n  errors.push(\"Recommended price not found in flight data\");\n}\n\nif (ai?.budget !== budget) {\n  errors.push(\"AI budget does not match input\");\n}\n\nif (!Array.isArray(ai?.flights) ||\n    ai.flights.length === 0 ||\n    ai.flights.length > 5 ||\n    ai.flights.some(f => !prices.includes(f.price))) {\n  errors.push(\"Invalid AI flight options\");\n}\n\nreturn [{\n  json: {\n    budget: budget,\n    cheapest_price: cheapest,\n    recommended_price: ai?.recommended_price ?? null,\n    flights_found: flights.length,\n    savings: cheapest !== null\n      ? budget - cheapest : null,\n    decision: errors.length > 0\n      ? \"REVIEW\"\n      : cheapest <= budget\n        ? \"WITHIN BUDGET\"\n        : \"OVER BUDGET\",\n    validation_passed: errors.length === 0,\n    review_reason: errors.join(\"; \"),\n    ai_analysis: JSON.stringify(ai ?? raw)\n  }\n}];\n"
      },
