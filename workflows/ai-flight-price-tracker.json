    {
      "parameters": {
        "jsCode": "const data = $('HTTP Request').first().json;\n\nconst budget = 2000;\n\nconst flights = [\n  ...(data.best_flights || []),\n  ...(data.other_flights || [])\n].filter(f => typeof f.price === 'number');\n\nconst cheapest = flights.length\n  ? Math.min(...flights.map(f => f.price))\n  : null;\n\nreturn [{\n  json: {\n    budget: budget,\n    cheapest_price: cheapest,\n    flights_found: flights.length,\n    savings: cheapest !== null\n      ? budget - cheapest : null,\n    decision: cheapest === null\n      ? \"REVIEW\"\n      : cheapest <= budget\n        ? \"WITHIN BUDGET\"\n        : \"OVER BUDGET\",\n    ai_analysis: $input.first().json.text\n  }\n}];"
      },
