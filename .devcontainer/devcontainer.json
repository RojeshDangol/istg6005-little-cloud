{
  "name": "ai-cloud-devops-devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [5678, 8080],
  "mounts": [
    "source=${localWorkspaceFolder},target=/data,type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "npm install -g @openai/codex@latest && codex --version"
}
